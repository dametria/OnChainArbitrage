# Network RPC URLs - Get from Alchemy or Infura
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
OPTIMISM_RPC_URL=

# WebSocket RPC URLs (for event-driven monitoring - 95% less API calls!)
ALCHEMY_WSS_URL=
INFURA_WSS_URL=
ANKR_WSS_URL=

# Testnet RPCs
ARBITRUM_TESTNET_RPC_URL=
POLYGON_TESTNET_RPC_URL=

# Private Keys (NEVER COMMIT THE REAL VALUES)

# Deployed FlashLoanArbitrage contract addresses (REQUIRED for the chain you run)
POLYGON_CONTRACT_ADDRESS=
BSC_CONTRACT_ADDRESS=
BASE_CONTRACT_ADDRESS=
# Generic fallback only used when NETWORK=polygon
CONTRACT_ADDRESS=

# Optional: override Aave provider on BSC if you use a custom deployment
BSC_AAVE_PROVIDER=

PRIVATE_KEY=
DEPLOYER_ADDRESS=

# API Keys
ALCHEMY_API_KEY=
INFURA_API_KEY=
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
POLYGONSCAN_API_KEY=

# Bot Configuration
MIN_PROFIT_THRESHOLD=0.4  # Minimum profit percentage (40 bps for volatile token strategy)
MAX_GAS_PRICE=1500  # Maximum gas price in Gwei (1500 Gwei × 300k gas = 0.45 MATIC = ~$0.18 per tx)
SLIPPAGE_TOLERANCE=1.5  # Maximum slippage in % (increased to handle price movement during execution)
FLASH_LOAN_PROVIDER=aave-v3  # Options: aave-v3, uniswap-v3, balancer

# Trading Parameters
MIN_TRADE_SIZE_USD=200  # Minimum $200 for volatile strategy (capture more opportunities)
MAX_TRADE_SIZE_USD=10000  # Maximum $10k to avoid excessive slippage
MAX_CONCURRENT_TRADES=3

# Monitoring
PRICE_CHECK_INTERVAL=1000  # Milliseconds (only used for HTTP polling - WebSocket ignores this)
USE_WEBSOCKET=true  # Use WebSocket event-driven monitoring (95% less API calls!)
ENABLE_MEMPOOL_MONITORING=true
ENABLE_NOTIFICATIONS=false

# Security
USE_FLASHBOTS=true  # Enable MEV protection
USE_PRIVATE_RPC=false
MAX_DAILY_LOSS=25  # Maximum daily loss in USD

# Database (Optional - for logging and analytics)
DATABASE_URL=

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Development
# Required: set NETWORK to one of: polygon | bsc | base
NETWORK=

# Optional chain-agnostic HTTP RPC fallback (used when primary RPC is missing or is WSS-only)
FALLBACK_HTTP_RPC_URL=
